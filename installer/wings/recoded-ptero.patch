+package router
+
+// Recoded Ptero: copy all files of another server on this node into a server (see server/clone_recoded.go).
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+
+	"github.com/pterodactyl/wings/router/middleware"
+	"github.com/pterodactyl/wings/server"
+)
+
+// postServerRecodedClone starts copying the files of "source" into the server in the URL.
+// The answer comes right away; the progress is read with getServerRecodedClone.
+func postServerRecodedClone(c *gin.Context) {
+	target := ExtractServer(c)
+
+	var data struct {
+		Source string `json:"source" binding:"required"`
+		Batch  string `json:"batch" binding:"required"`
+	}
+	if err := c.BindJSON(&data); err != nil {
+		return
+	}
+
+	source, ok := middleware.ExtractManager(c).Get(data.Source)
+	if !ok {
+		c.AbortWithStatusJSON(http.StatusNotFound, gin.H{"error": "The source server is not on this node."})
+		return
+	}
+
+	if err := server.StartClone(target, source, data.Batch); err != nil {
+		var conflict *server.ErrCloneConflict
+		if errors.As(err, &conflict) {
+			c.AbortWithStatusJSON(http.StatusConflict, gin.H{"error": conflict.Reason})
+			return
+		}
+		middleware.CaptureAndAbort(c, err)
+		return
+	}
+
+	c.JSON(http.StatusAccepted, server.CloneStatusOf(target.ID()))
+}
+
+// getServerRecodedClone returns the status of the last copy into the server (404 when there was none).
+func getServerRecodedClone(c *gin.Context) {
+	st := server.CloneStatusOf(ExtractServer(c).ID())
+	if st == nil {
+		c.AbortWithStatusJSON(http.StatusNotFound, gin.H{"error": "No copy was started for this server."})
+		return
+	}
+	c.JSON(http.StatusOK, st)
+}
